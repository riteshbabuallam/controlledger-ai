CONTROLLEDGER_DB_PATH=data/controlledger.db
CONTROLLEDGER_POLICY_DIR=data/policies
CONTROLLEDGER_CONTROLS_PATH=data/controls/expense_controls.yaml
CONTROLLEDGER_API_URL=http://localhost:8000
CONTROLLEDGER_RAG_BACKEND=chroma
CONTROLLEDGER_AI_MODE=auto
CONTROLLEDGER_AI_PROVIDER=gemini
CONTROLLEDGER_LLM_MODEL=gemini-3.1-flash-lite
CONTROLLEDGER_EMBEDDING_MODEL=gemini-embedding-2
# Cost-estimation defaults for the configured models, in USD per 1M tokens.
CONTROLLEDGER_LLM_INPUT_USD_PER_M=0
CONTROLLEDGER_LLM_OUTPUT_USD_PER_M=0
CONTROLLEDGER_EMBEDDING_INPUT_USD_PER_M=0
GEMINI_API_KEY=
